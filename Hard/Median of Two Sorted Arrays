#pragma GCC optimize("O3")

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Ensure nums1 is always the smaller array
    if (nums1Size > nums2Size) {
        int* tempPtr = nums1;
        nums1 = nums2;
        nums2 = tempPtr;

        int tempLen = nums1Size;
        nums1Size = nums2Size;
        nums2Size = tempLen;
    }

    int m = nums1Size;
    int n = nums2Size;
    int low = 0, high = m;
    int halfLen = (m + n + 1) / 2;

    while (low <= high) {
        int i = low + (high - low) / 2;
        int j = halfLen - i;

        int maxLeft1 = (i == 0) ? -2147483648 : nums1[i - 1];
        int minRight1 = (i == m) ? 2147483647 : nums1[i];

        int maxLeft2 = (j == 0) ? -2147483648 : nums2[j - 1];
        int minRight2 = (j == n) ? 2147483647 : nums2[j];

        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {
            int maxLeft = (maxLeft1 > maxLeft2) ? maxLeft1 : maxLeft2;
            
            if ((m + n) % 2 != 0) {
                return maxLeft;
            }

            int minRight = (minRight1 < minRight2) ? minRight1 : minRight2;
            return (maxLeft + minRight) / 2.0;
        } else if (maxLeft1 > minRight2) {
            high = i - 1;
        } else {
            low = i + 1;
        }
    }

    return 0.0;
}
